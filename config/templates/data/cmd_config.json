{
  "config_version": 3,
  "platform_settings": {
    "unique_session": false,
    "rate_limit": {
      "time": 60,
      "count": 30,
      "strategy": "stall"
    },
    "reply_prefix": "",
    "forward_threshold": 1500,
    "enable_id_white_list": true,
    "id_whitelist": [],
    "id_whitelist_log": true,
    "wl_ignore_admin_on_group": true,
    "wl_ignore_admin_on_friend": true,
    "reply_with_mention": false,
    "reply_with_quote": true,
    "path_mapping": [],
    "segmented_reply": {
      "enable": false,
      "only_llm_result": false,
      "interval_method": "log",
      "interval": "1.5,3.5",
      "log_base": 2.6,
      "words_count_threshold": 150,
      "split_mode": "regex",
      "regex": ".*?[。]+|.+$",
      "split_words": [
        "。",
        "？",
        "！",
        "~",
        "…"
      ],
      "content_cleanup_rule": "'[。]'"
    },
    "no_permission_reply": true,
    "empty_mention_waiting": false,
    "empty_mention_waiting_need_reply": true,
    "friend_message_needs_wake_prefix": false,
    "ignore_bot_self_message": false,
    "ignore_at_all": false
  },
  "provider_sources": [
    {
      "id": "Google_source",
      "provider": "openai",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": [
        "{{AB_CMD_PROVIDER_SOURCES_0_KEY_0}}"
      ],
      "api_base": "{{AB_CMD_PROVIDER_SOURCES_0_API_BASE}}",
      "timeout": 120,
      "hint": "也兼容所有与OpenAI API兼容的服务。",
      "custom_headers": {}
    },
    {
      "id": "claude_source",
      "hint": "注意Claude系列模型的温度调节范围为0到1.0，超出可能导致报错",
      "provider": "anthropic",
      "type": "anthropic_chat_completion",
      "provider_type": "chat_completion",
      "key": [
        "{{AB_CMD_PROVIDER_SOURCES_1_KEY_0}}"
      ],
      "api_base": "{{AB_CMD_PROVIDER_SOURCES_1_API_BASE}}",
      "timeout": 120
    },
    {
      "id": "deepseek_v4_flash_source",
      "provider": "openai",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": [
        "{{AB_CMD_PROVIDER_SOURCES_2_KEY_0}}"
      ],
      "api_base": "{{AB_CMD_PROVIDER_SOURCES_2_API_BASE}}",
      "timeout": 120,
      "custom_headers": {}
    }
  ],
  "provider": [
    {
      "id": "Google",
      "enable": true,
      "modalities": [
        "text",
        "image",
        "tool_use"
      ],
      "custom_extra_body": {
        "temperature": 1.0
      },
      "provider_source_id": "Google_source",
      "model": "gemini-3-flash-preview"
    },
    {
      "id": "claude",
      "enable": true,
      "modalities": [
        "text",
        "image",
        "tool_use"
      ],
      "provider_source_id": "claude_source",
      "model": "claude-haiku-4-5-20251001",
      "custom_extra_body": {
        "max_tokens": 4096,
        "temperature": 0.2
      }
    },
    {
      "id": "gsv_tts",
      "enable": true,
      "provider": "gpt_sovits",
      "type": "gsv_tts_selfhost",
      "provider_type": "text_to_speech",
      "api_base": "{{AB_CMD_PROVIDER_2_API_BASE}}",
      "gpt_weights_path": "{{AB_CMD_PROVIDER_2_GPT_WEIGHTS_PATH}}",
      "sovits_weights_path": "{{AB_CMD_PROVIDER_2_SOVITS_WEIGHTS_PATH}}",
      "timeout": 60,
      "gsv_default_parms": {
        "gsv_ref_audio_path": "{{AB_CMD_PROVIDER_2_GSV_DEFAULT_PARMS_GSV_REF_AUDIO_PATH}}",
        "gsv_prompt_text": "メイドには、ご主人様が必要です。アリスのご主人様は、もちろん先生です！",
        "gsv_prompt_lang": "ja",
        "gsv_aux_ref_audio_paths": "",
        "gsv_text_lang": "auto",
        "gsv_top_k": 5,
        "gsv_top_p": 1.0,
        "gsv_temperature": 1.0,
        "gsv_text_split_method": "cut3",
        "gsv_batch_size": 1,
        "gsv_batch_threshold": 0.75,
        "gsv_split_bucket": true,
        "gsv_speed_factor": 1.0,
        "gsv_fragment_interval": 0.3,
        "gsv_streaming_mode": false,
        "gsv_seed": -1,
        "gsv_parallel_infer": true,
        "gsv_repetition_penalty": 1.35,
        "gsv_media_type": "wav"
      }
    },
    {
      "id": "deepseek_v4_flash",
      "enable": true,
      "modalities": [
        "text",
        "image",
        "tool_use"
      ],
      "custom_extra_body": {
        "temperature": 0.7
      },
      "provider_source_id": "deepseek_v4_flash_source",
      "model": "deepseek-flash"
    }
  ],
  "provider_settings": {
    "enable": false,
    "default_image_caption_provider_id": "deepseek_v4_flash",
    "image_caption_prompt": "请基于画面本身用中文简洁描述图片；优先准确抄录截图、表情包、UI、弹幕中的可见文字，并说明主体、动作、场景和情绪意图。能可靠确认角色或作品时再写名称，无法确认就明确说明，不要猜测。",
    "provider_pool": [
      "*"
    ],
    "wake_prefix": "",
    "web_search": true,
    "websearch_provider": "tavily",
    "websearch_tavily_key": [
      "{{AB_CMD_PROVIDER_SETTINGS_WEBSEARCH_TAVILY_KEY_0}}"
    ],
    "websearch_bocha_key": [],
    "websearch_brave_key": [],
    "websearch_baidu_app_builder_key": "",
    "websearch_firecrawl_key": [],
    "websearch_exa_key": [],
    "websearch_anysearch_key": [],
    "web_search_link": false,
    "display_reasoning_text": false,
    "identifier": true,
    "group_name_display": true,
    "datetime_system_prompt": true,
    "persona_pool": [
      "*"
    ],
    "prompt_prefix": "",
    "streaming_response": false,
    "show_tool_use_status": false,
    "show_tool_call_result": false,
    "buffer_intermediate_messages": false,
    "max_quoted_fallback_images": 20,
    "quoted_message_parser": {
      "max_component_chain_depth": 4,
      "max_forward_node_depth": 6,
      "max_forward_fetch": 32,
      "warn_on_action_failure": false
    },
    "unsupported_streaming_strategy": "realtime_segmenting",
    "reachability_check": false,
    "file_extract": {
      "enable": false,
      "provider": "moonshotai",
      "moonshotai_api_key": ""
    },
    "proactive_capability": {
      "add_cron_tools": true
    },
    "computer_use_runtime": "none",
    "computer_use_require_admin": true,
    "sandbox": {
      "booter": "shipyard_neo",
      "shipyard_endpoint": "",
      "shipyard_access_token": "",
      "shipyard_ttl": 3600,
      "shipyard_max_sessions": 10,
      "shipyard_neo_endpoint": "",
      "shipyard_neo_access_token": "",
      "shipyard_neo_profile": "python-default",
      "shipyard_neo_ttl": 3600,
      "cua_image": "linux",
      "cua_os_type": "linux",
      "cua_idle_timeout": 0,
      "cua_telemetry_enabled": false,
      "cua_local": true,
      "cua_api_key": ""
    },
    "image_compress_enabled": true,
    "image_compress_options": {
      "max_size": 1280,
      "quality": 95
    }
  },
  "agent_runner": {
    "runner_type": "local",
    "config": {
      "model": {
        "provider_id": "Google",
        "fallback_provider_ids": [],
        "request_max_retries": 5
      },
      "persona": {
        "persona_id": "天童爱丽丝",
        "safety_mode": true,
        "safety_mode_strategy": "system_prompt"
      },
      "compression": {
        "max_turns": -1,
        "trim_turns": 1,
        "overflow_strategy": "llm_compress",
        "instruction": "",
        "keep_recent_ratio": 0.15,
        "provider_id": "",
        "fallback_max_tokens": 128000
      },
      "misc": {
        "max_steps": 30,
        "tool_schema_mode": "full",
        "tool_call_timeout": 60,
        "sanitize_context_by_modalities": false
      }
    }
  },
  "subagent_orchestrator": {
    "main_enable": false,
    "remove_main_duplicate_tools": false,
    "router_system_prompt": "You are a task router. Your job is to chat naturally, recognize user intent, and delegate work to the most suitable subagent using transfer_to_* tools. Do not try to use domain tools yourself. If no subagent fits, respond directly.",
    "agents": []
  },
  "provider_stt_settings": {
    "enable": false,
    "provider_id": ""
  },
  "provider_tts_settings": {
